{
	"name": "df_detalle_pedidos",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "detalle_pedidos_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "detalle_pedidos_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          detalle_id as string,",
				"          pedido_id as string,",
				"          producto_id as string,",
				"          cantidad as string,",
				"          precio_unitario as string,",
				"          descuento_linea as string,",
				"          total_linea as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 split(!isNull(detalle_id) && trim(detalle_id) != '' && !isNull(pedido_id) && trim(pedido_id) != '' && !isNull(producto_id) && trim(producto_id) != '' && !isNull(cantidad) && !isNull(precio_unitario) && !isNull(total_linea),",
				"     disjoint: false) ~> split1@(valido, rechazado)",
				"split1@valido sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          detalle_id as string,",
				"          pedido_id as string,",
				"          producto_id as string,",
				"          cantidad as integer,",
				"          precio_unitario as decimal(12,2),",
				"          descuento_linea as decimal(12,2),",
				"          total_linea as decimal(12,2)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}