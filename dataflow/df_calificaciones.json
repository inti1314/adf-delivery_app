{
	"name": "df_calificaciones",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "calificaciones_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "calificaciones_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          calificacion_id as string,",
				"          pedido_id as string,",
				"          cliente_id as string,",
				"          fecha_calificacion as string,",
				"          puntuacion as string,",
				"          comentario as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(comentario = trim(comentario)) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(calificacion_id) && trim(calificacion_id) != '' && !isNull(pedido_id) && trim(pedido_id) != '' && !isNull(cliente_id) && trim(cliente_id) != '' && !isNull(puntuacion),",
				"     disjoint: false) ~> split1@(valido, rechazado)",
				"split1@valido sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          calificacion_id as string,",
				"          pedido_id as string,",
				"          cliente_id as string,",
				"          fecha_calificacion as date,",
				"          puntuacion as integer,",
				"          comentario as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}